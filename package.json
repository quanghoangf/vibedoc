    "next": "latest",
    "open": "^11.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.0",
    "y-codemirror.next": "^0.3.6",
