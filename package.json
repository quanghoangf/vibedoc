    ".next/server/",
    ".next/static/",
    "public/",
    "skills/",
    "next.config.js",
    "ws-server.js",
    "package.json"
  ],
  "scripts": {
    "dev": "concurrently \"next dev\" \"node ws-server.js\" --names \"next,ws\" --prefix-colors \"cyan,yellow\"",
    "dev:next": "next dev",
    "dev:ws": "node ws-server.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "release": "semantic-release",
    "prepublishOnly": "next build"
  },
