{
  "name": "vibedoc",
  "version": "1.16.0",
  "homepage": "https://quanghoangf.github.io/vibedoc/",
  "description": "Local-first project intelligence for AI-assisted development. Web UI + MCP server in one.",
  "license": "MIT",
  "bin": {
    "vibedoc": "./bin/vibedoc.mjs"
  },
  "exports": {
    "./package.json": "./package.json",
    "./playwright": {
      "types": "./dist/testing/playwright-fixture.d.ts",
      "default": "./dist/testing/playwright-fixture.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/quanghoangf/vibedoc.git"
  },
  "files": [
    "bin/",
    "LICENSE",
    "README.md",
    ".next/BUILD_ID",
    ".next/build-manifest.json",
    ".next/app-build-manifest.json",
    ".next/app-path-routes-manifest.json",
    ".next/prerender-manifest.json",
    ".next/prerender-manifest.js",
    ".next/react-loadable-manifest.json",
    ".next/routes-manifest.json",
    ".next/required-server-files.json",
    ".next/server/",
    ".next/static/",
    "public/",
    "plugin/",
    "examples/demo-project/",
    "examples/demo-runs/listly/",
    "dist/testing/",
    "dist/lib/",
    "dist/cli/",
    "src/testing/playwright-fixture.ts",
    "src/testing/vibedoc-reporter.ts",
    "src/lib/runs-paths.ts",
    "src/lib/runs-retention.ts",
    "src/lib/manual-tests.ts",
    "src/lib/evidence.ts",
    "src/lib/honesty.ts",
    "src/lib/task-map.ts",
    "docs/getting-started.md",
    "next.config.js",
    "ws-server.js",
    "package.json"
  ],
  "scripts": {
    "dev": "concurrently \"next dev\" \"node ws-server.js\" --names \"next,ws\" --prefix-colors \"cyan,yellow\"",
    "dev:next": "next dev",
    "dev:ws": "node ws-server.js",
    "build": "next build",
    "start": "next start",
    "demo": "VIBEDOC_DEMO=1 VIBEDOC_ROOT=examples/demo-project next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "release": "semantic-release",
    "prepublishOnly": "next build && npm run build:playwright && npm run build:cli",
    "build:playwright": "tsc -p tsconfig.playwright.json",
    "version": "node -e \"const f='plugin/.claude-plugin/plugin.json',fs=require('fs'),j=JSON.parse(fs.readFileSync(f));j.version=require('./package.json').version;fs.writeFileSync(f,JSON.stringify(j,null,2)+'\\n')\"",
    "build:cli": "esbuild src/cli/check.ts --bundle --platform=node --format=esm --target=node18 --packages=external --outfile=dist/cli/check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "mermaid": "^12.0.0",
    "next": "latest",
    "open": "^11.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.0",
    "y-codemirror.next": "^0.3.6",
    "y-websocket": "^2.1.0",
    "yjs": "^13.6.33"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "latest",
    "postcss": "^8.5.28",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
