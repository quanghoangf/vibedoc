# Generated by scripts/homebrew-formula.mjs at each release; edit the template in the vibedoc repo, not this file.
class Vibedoc < Formula
  desc "Local-first project intelligence for AI-assisted development: kanban, docs and an MCP server"
  homepage "https://quanghoangf.github.io/vibedoc/"
  url "https://registry.npmjs.org/vibedoc/-/vibedoc-{{version}}.tgz"
  sha256 "{{sha256}}"
  license "MIT"

  depends_on "node"

  def install
    system "npm", "install", *std_npm_args
    bin.install_symlink libexec.glob("bin/*")
  end

  test do
    assert_equal version.to_s, shell_output("#{bin}/vibedoc --version").strip
  end
end
