#!/usr/bin/env node
// A fake `claude` CLI for e2e/connect-agent.mjs and src/lib/claude-cli.check.mts (R081). Put this folder first on
// PATH. State lives in the cwd (the project VibeDoc runs it in): .claude-stub.json, every call appended to
// .claude-stub.log as "<argv joined by spaces>". Mimics Claude Code 2.1's output for the commands VibeDoc runs,
// plus a slow `-p` chat turn for e2e/chat-reload.mjs.
const fs = require("node:fs")
const path = require("node:path")
const args = process.argv.slice(2)
const stateFile = path.join(process.cwd(), ".claude-stub.json")
const state = fs.existsSync(stateFile) ? JSON.parse(fs.readFileSync(stateFile, "utf8")) : {}
const save = () => fs.writeFileSync(stateFile, JSON.stringify(state))
fs.appendFileSync(path.join(process.cwd(), ".claude-stub.log"), args.join(" ") + "\n")
const cmd = args.slice(0, 2).join(" ")
// `plugin marketplace add <repo>` registers the marketplace under the name its marketplace.json declares
const MARKETPLACE_NAMES = { "quanghoangf/vibedoc": "vibedoc", "anthropics/claude-plugins-official": "claude-plugins-official", "anthropics/skills": "anthropic-agent-skills" }

if (cmd === "mcp add" && args.includes("--scope") && args[args.indexOf("--scope") + 1] === "user") {
  // R104: the user-scope server (one for every project); the URL is the arg after the name
  if (state.mcpUser) { console.error("MCP server vibedoc already exists in user config"); process.exit(1) }
  const h = args.indexOf("--header")
  state.mcpUser = { url: args[args.indexOf("vibedoc") + 1], header: h > 0 ? args[h + 1] : null }; save()
  console.log(`Added HTTP MCP server vibedoc with URL: ${state.mcpUser.url} to user config`)
  if (state.mcpUser.header) console.log(`Headers: {\n  "${state.mcpUser.header.replace(": ", '": "')}"\n}`)
  console.log(`File modified: ${process.env.HOME}/.claude.json`)
} else if (cmd === "mcp remove" && args.slice(-2).join(" ") === "-s user") {
  if (!state.mcpUser) { console.error("No user-scoped MCP server found with name: vibedoc"); process.exit(1) }
  delete state.mcpUser; save()
  console.log("Removed MCP server vibedoc from user config")
} else if (cmd === "mcp add") {
  if (state.mcp) { console.error("MCP server vibedoc already exists in local config"); process.exit(1) }
  state.mcp = args[args.length - 1]; save()
  console.log(`Added HTTP MCP server vibedoc with URL: ${state.mcp} to local config`)
  console.log(`File modified: ${process.env.HOME}/.claude.json [project: ${process.cwd()}]`)
} else if (cmd === "mcp remove") {
  if (!state.mcp) { console.error("No MCP server found with name: vibedoc"); process.exit(1) }
  delete state.mcp; save()
  console.log("Removed MCP server vibedoc from local config")
} else if (args.join(" ") === "plugin list --json") {
  console.log(JSON.stringify(state.plugins ?? [], null, 2))
} else if (args.join(" ") === "plugin marketplace list --json") {
  console.log(JSON.stringify(state.marketplaces ?? [], null, 2))
} else if (args.slice(0, 3).join(" ") === "plugin marketplace add") {
  const name = MARKETPLACE_NAMES[args[3]] ?? args[3].split("/").pop()
  state.marketplaces = [...(state.marketplaces ?? []), { name, source: "github", repo: args[3] }]; save()
  console.log(`Successfully added marketplace: ${name}`)
} else if (cmd === "plugin install") {
  // "<plugin>@<marketplace>" needs that marketplace; a bare name needs the vibedoc one (R081's step)
  const mkt = args[2].includes("@") ? args[2].split("@")[1] : "vibedoc"
  if (!(state.marketplaces ?? []).some((m) => m.name === mkt)) { console.error(`Plugin "${args[2]}" not found in any marketplace`); process.exit(1) }
  // R098: state.failInstall lists ids whose install fails with a real-looking error
  if ((state.failInstall ?? []).includes(args[2])) { console.error(`✘ Failed to install plugin "${args[2]}": git clone failed (network unreachable)`); process.exit(1) }
  state.plugins = [...(state.plugins ?? []), { id: args[2], version: "1.16.0", scope: "user", enabled: true }]; save()
  console.log(`✔ Successfully installed plugin: ${args[2]} (scope: user)`)
} else if (args[0] === "-p" && args.includes("--plugin-dir")) {
  // R108 worker task turn (e2e/worker-run.mjs): cwd = the worktree. After CLAUDE_STUB_WORKER_MS (default 2s, long
  // enough to cancel mid-task) write <task>.txt, commit only that file, then mark the task done over the MCP URL.
  // T558 (e2e/worker-ask.mjs): a task listed in the worktree's .claude-stub-ask asks instead (vibedoc_ask_questions)
  // and exits 0 with the task still in-progress; `--resume stub-worker-<task>` (the answer) then does the task.
  // T557: writes its env names to .claude-stub-env.json and tries `git push` once, refused like Claude Code 2.1 does
  // (ADR-007 § Spike) when the argv's --disallowedTools has Bash(git push*).
  // T567: .claude-stub-outcomes in the worktree ({"T001": "max-turns" | "hang" | "usage-limit"}) makes that task's first
  // fresh turn hit `--max-turns` (exit 1, error_max_turns), never finish (the server's timeout kills it), or fail on a
  // usage limit that resets in 6 s (rate_limit_event rejected + an is_error result, exit 1). Later turns do the task.
  const resume = args.includes("--resume") ? args[args.indexOf("--resume") + 1] : null
  const taskId = (resume ?? args[1]).match(/\bT\d{3,}\b/)[0]
  const { url, headers } = JSON.parse(args[args.indexOf("--mcp-config") + 1]).mcpServers.vibedoc
  const sid = `stub-worker-${taskId}`
  const out = (o) => process.stdout.write(JSON.stringify(o) + "\n")
  fs.writeFileSync(".claude-stub-env.json", JSON.stringify(Object.keys(process.env).sort()))
  out({ type: "system", subtype: "init", session_id: sid })
  const push = { tool_name: "Bash", tool_use_id: `tu-push-${taskId}`, tool_input: { command: "git push origin HEAD" } }
  const denied = args.slice(args.indexOf("--disallowedTools") + 1).includes("Bash(git push*)")
  out({ type: "assistant", session_id: sid, message: { content: [{ type: "tool_use", id: push.tool_use_id, name: "Bash", input: push.tool_input }] } })
  if (denied) {
    out({ type: "system", subtype: "permission_denied", session_id: sid, tool_name: "Bash", tool_use_id: push.tool_use_id, decision_reason_type: "subcommandResults", message: `Permission to use Bash with command ${push.tool_input.command} has been denied.` })
    out({ type: "user", session_id: sid, message: { content: [{ type: "tool_result", tool_use_id: push.tool_use_id, is_error: true, content: "Permission denied" }] } })
  }
  process.on("SIGTERM", () => process.exit(143))
  const outcomes = fs.existsSync(".claude-stub-outcomes") ? JSON.parse(fs.readFileSync(".claude-stub-outcomes", "utf8")) : {}
  state.outcomeSeen = state.outcomeSeen ?? []
  const outcome = !resume && !state.outcomeSeen.includes(taskId) ? outcomes[taskId] : undefined
  if (outcome) { state.outcomeSeen.push(taskId); save() }
  const usage = { num_turns: 3, duration_ms: 1500, total_cost_usd: 0.25, usage: { input_tokens: 10, cache_creation_input_tokens: 1000, cache_read_input_tokens: 2000, output_tokens: 90 } }
  out({ type: "rate_limit_event", session_id: sid, rate_limit_info: { status: outcome === "usage-limit" ? "rejected" : "allowed", rateLimitType: "five_hour", resetsAt: Math.floor(Date.now() / 1000) + 6, unifiedWindows: { five_hour: { utilization: outcome === "usage-limit" ? 1 : 0.43 } } } })
  if (outcome === "max-turns") {
    const max = Number(args[args.indexOf("--max-turns") + 1])
    for (let i = 0; i <= max; i++) out({ type: "assistant", session_id: sid, message: { content: [{ type: "tool_use", id: `glob-${i}`, name: "Glob", input: { pattern: "*" } }] } })
    out({ type: "result", subtype: "error_max_turns", session_id: sid, is_error: true, terminal_reason: "max_turns", errors: [`Reached maximum number of turns (${max})`], ...usage, num_turns: max + 1 })
    return void (process.exitCode = 1) // not exit(): a pipe on macOS may drop the lines above
  }
  if (outcome === "usage-limit") {
    out({ type: "result", subtype: "success", session_id: sid, is_error: true, result: `Claude AI usage limit reached|${Math.floor(Date.now() / 1000) + 6}`, ...usage })
    return void (process.exitCode = 1) // not exit(): a pipe on macOS may drop the lines above
  }
  if (outcome === "hang") return void setInterval(() => {}, 60_000)
  const asks = fs.existsSync(".claude-stub-ask") ? fs.readFileSync(".claude-stub-ask", "utf8").split(/\s+/) : []
  const asking = !resume && asks.includes(taskId)
  if (asking) {
    const questions = [{ question: `Which storage should ${taskId} use?`, header: "Storage", multiSelect: false, options: [{ label: "Files", description: "Plain files" }, { label: "SQLite", description: "One db file" }] }]
    out({ type: "assistant", session_id: sid, message: { content: [{ type: "tool_use", id: `ask-${taskId}`, name: "mcp__vibedoc__vibedoc_ask_questions", input: { questions } }] } })
    out({ type: "user", session_id: sid, message: { content: [{ type: "tool_result", tool_use_id: `ask-${taskId}`, content: "Shown to the user" }] } })
    out({ type: "result", session_id: sid, is_error: false, result: `I need a decision on ${taskId} before I go on.` })
  }
  if (!asking) setTimeout(async () => {
    const { execFileSync } = require("node:child_process")
    fs.writeFileSync(`${taskId}.txt`, `${taskId} was here\n`)
    execFileSync("git", ["add", `${taskId}.txt`])
    execFileSync("git", ["-c", "user.name=stub", "-c", "user.email=stub@example.com", "commit", "-q", "-m", `feat: ${taskId}`])
    const res = await fetch(url, {
      method: "POST", headers: { "content-type": "application/json", ...headers },
      body: JSON.stringify({ jsonrpc: "2.0", id: 1, method: "tools/call", params: { name: "vibedoc_update_task", arguments: { taskId, status: "done" } } }),
    })
    const text = (await res.json()).result.content[0].text
    out({ type: "assistant", session_id: sid, message: { content: [{ type: "text", text: `Done ${taskId}` }] } })
    out({ type: "result", session_id: sid, is_error: false, result: `Done ${taskId}: ${text.split("\n")[0]}`, permission_denials: denied ? [push] : [], ...usage })
  }, Number(process.env.CLAUDE_STUB_WORKER_MS ?? 2000))
} else if (args[0] === "-p") {
  // A chat turn (e2e/chat-reload.mjs): stream-json over ~4s, slow enough to reload the page mid-turn.
  // CLAUDE_STUB_TURN_MS overrides the length; the reply names the prompt so the test can find it.
  const prompt = args[1]
  const words = ["Checked", "the", "task", "and", "found", "nothing", "wrong:", JSON.stringify(prompt.slice(-30))]
  const step = Number(process.env.CLAUDE_STUB_TURN_MS ?? 4000) / words.length
  const out = (o) => process.stdout.write(JSON.stringify(o) + "\n")
  const sid = "stub-session-1"
  out({ type: "system", subtype: "init", session_id: sid })
  out({ type: "stream_event", session_id: sid, event: { type: "message_start" } })
  let i = 0
  const timer = setInterval(() => {
    if (i < words.length) {
      out({ type: "stream_event", session_id: sid, event: { type: "content_block_delta", delta: { type: "text_delta", text: (i ? " " : "") + words[i] } } })
      i++
      return
    }
    clearInterval(timer)
    out({ type: "assistant", session_id: sid, message: { content: [{ type: "text", text: words.join(" ") }] } })
    out({ type: "result", session_id: sid, is_error: false, result: words.join(" ") })
  }, step)
  process.on("SIGTERM", () => process.exit(143))
} else {
  console.error(`claude stub: unknown command ${args.join(" ")}`); process.exit(2)
}
