---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import InstallSteps from '../components/InstallSteps.astro'
import BoardShot from '../components/BoardShot.astro'
import Loop from '../components/Loop.astro'
import DemoVideo from '../components/DemoVideo.astro'
import Features from '../components/Features.astro'
---
<Base
  title="VibeDoc · Spec-driven development for AI coding agents"
  description="Every task your agent finishes comes with proof. VibeDoc keeps your plan, specs and memory as markdown in your repo; Claude Code, Cursor or any MCP agent works them, and you review each task on its tests, screenshots and video."
>
  <Header />
  <main>
    <Hero />
    <BoardShot />
    <DemoVideo />
    <Loop />
    <Features />
    <InstallSteps />
  </main>
</Base>
