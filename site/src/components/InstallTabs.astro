---
// The hero's install box: one tab per channel (src/data/install.ts), the selected command with Copy, and its note.
// Without JavaScript the first channel shows. Arrow keys / Home / End move between tabs (ARIA tabs pattern).
import CopyCommand from './CopyCommand.astro'
import { INSTALL } from '../data/install'
---
<div class="min-w-0 flex-[0_1_500px] overflow-hidden rounded-xl border border-rule bg-surface shadow-[0_12px_32px_rgba(26,26,46,0.06)]" data-install>
  <div role="tablist" aria-label="Install with" class="flex flex-wrap gap-0.5 border-b border-rule px-1.5 pt-1.5">
    {INSTALL.map((c, i) => (
      <button
        type="button"
        role="tab"
        id={`install-tab-${c.id}`}
        aria-controls={`install-panel-${c.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class="min-h-10 cursor-pointer border-0 border-b-2 border-transparent bg-transparent px-3 text-sm text-pencil hover:text-ink aria-selected:border-violet aria-selected:font-medium aria-selected:text-ink"
      >{c.label}</button>
    ))}
  </div>
  {INSTALL.map((c, i) => (
    <div role="tabpanel" id={`install-panel-${c.id}`} aria-labelledby={`install-tab-${c.id}`} hidden={i !== 0}>
      <CopyCommand command={c.command} />
      <p class="m-0 px-4 py-2.5 text-[13px] text-pencil">{c.note}</p>
    </div>
  ))}
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-install]')) {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[role="tab"]')]
    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab
        t.setAttribute('aria-selected', String(on))
        t.tabIndex = on ? 0 : -1
        box.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`)!.hidden = !on
      }
      if (focus) tab.focus()
    }
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab))
      tab.addEventListener('keydown', (e) => {
        const next = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : null
        if (next === null) return
        e.preventDefault()
        select(tabs[(next + tabs.length) % tabs.length], true)
      })
    })
  }
</script>
