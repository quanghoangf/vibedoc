---
// The hero's install box: one tab per channel (src/data/install.ts), the selected command with Copy, and its note.
// Without JavaScript the first channel shows. Arrow keys / Home / End move between tabs (ARIA tabs pattern).
import CopyCommand from './CopyCommand.astro'
import { INSTALL, LATEST_DOWNLOAD } from '../data/install'
---
<div class="min-w-0 flex-[0_1_500px] overflow-hidden rounded-xl border border-rule bg-surface shadow-[0_12px_32px_rgba(26,26,46,0.06)]" data-tabs>
  <div role="tablist" aria-label="Install with" class="flex flex-wrap gap-0.5 border-b border-rule px-1.5 pt-1.5">
    {INSTALL.map((c, i) => (
      <button
        type="button"
        role="tab"
        id={`install-tab-${c.id}`}
        aria-controls={`install-panel-${c.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class="min-h-10 cursor-pointer border-0 border-b-2 border-transparent bg-transparent px-3 text-sm text-pencil hover:text-ink aria-selected:border-violet aria-selected:font-medium aria-selected:text-ink"
      >{c.label}</button>
    ))}
  </div>
  {INSTALL.map((c, i) => (
    <div role="tabpanel" id={`install-panel-${c.id}`} aria-labelledby={`install-tab-${c.id}`} hidden={i !== 0}>
      {c.downloads ? (
        <ul class="m-0 grid list-none gap-2 bg-ink p-3 sm:grid-cols-2" data-downloads>
          {c.downloads.map((d) => (
            <li>
              <a
                href={`${LATEST_DOWNLOAD}${d.file}`}
                data-os={d.os}
                data-goatcounter-click={`download-${d.file}`}
                class="flex min-h-10 items-center justify-between gap-2 rounded-md border border-[#3a3a52] px-3 text-sm text-[#e8e8f0] no-underline hover:border-violet data-[recommended]:border-violet data-[recommended]:bg-violet data-[recommended]:font-medium data-[recommended]:text-night"
              ><span>{d.label}</span><span aria-hidden="true">↓</span></a>
            </li>
          ))}
        </ul>
      ) : c.isPrompt ? (
        <div class="relative bg-ink text-[#e8e8f0]">
          <pre class="m-0 max-h-32 overflow-hidden px-4 pt-3 pb-14 font-mono text-[12.5px] leading-relaxed whitespace-pre-wrap" tabindex="-1">{c.command}</pre>
          <div class="absolute inset-x-0 bottom-0 flex items-end justify-end bg-linear-to-t from-ink from-45% to-transparent px-3 pt-10 pb-3">
            <button
              type="button"
              data-copy={c.command}
              data-goatcounter-click={`copy-${c.id}`}
              aria-label="Copy install prompt"
              class="min-h-10 cursor-pointer rounded-md bg-violet px-4 text-sm font-medium text-night transition-[filter] hover:brightness-110"
            >Copy prompt</button>
          </div>
        </div>
      ) : <CopyCommand command={c.command} event={`copy-${c.id}`} />}
      <p class="m-0 px-4 py-2.5 text-[13px] text-pencil">
        {c.note}{c.isPrompt && <> <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/docs/ai-install/`} class="text-violet-ink underline underline-offset-2">Read the full prompt</a></>}
      </p>
    </div>
  ))}
</div>

<script>
  import { setupTabs } from '../scripts/tabs'
  import { visitorOs } from '../scripts/visitor-os'
  setupTabs()
  // the visitor's own installer stands out (every link stays, a guess can be wrong)
  const os = visitorOs(navigator)
  for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-downloads] a[data-os]')) {
    if (os && a.dataset.os === os && !document.querySelector('[data-downloads] a[data-recommended]')) {
      a.dataset.recommended = ''
      a.setAttribute('aria-describedby', 'install-desktop-for-you')
    }
  }
</script>
<span id="install-desktop-for-you" hidden>For your computer</span>
