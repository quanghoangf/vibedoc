---
// The board in a browser frame, with two notes floating beside it (design: "Board screenshot + chips").
const src = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/screens/board.jpg`
---
<section aria-label="The board while an agent works" class="mx-auto max-w-[1200px] px-5 pt-8 pb-24 sm:px-8">
  <div class="vd-reveal relative">
    <div class="overflow-hidden rounded-[14px] border border-rule-strong bg-surface shadow-[0_30px_80px_rgba(26,26,46,0.12)]">
      <div class="flex items-center gap-1.5 border-b border-rule bg-paper px-3.5 py-2.5" aria-hidden="true">
        <span class="size-2.5 rounded-full bg-rule"></span><span class="size-2.5 rounded-full bg-rule"></span><span class="size-2.5 rounded-full bg-rule"></span>
        <span class="mx-auto font-mono text-[11px] text-pencil">localhost:3000/board</span>
      </div>
      <img src={src} width="2880" height="1800" alt="The VibeDoc board: tasks grouped by epic, each card with its test results and who is working on it" class="block h-auto w-full" />
    </div>
    <p class="vd-float absolute top-[26%] -left-4.5 m-0 hidden rounded-[10px] border border-rule-strong bg-surface px-3.5 py-2.5 font-mono text-xs leading-normal shadow-[0_12px_28px_rgba(26,26,46,0.12)] md:block">
      <span class="text-violet-ink">◆ ai:claude-code</span><br />claimed T186 · next ready task
    </p>
    <p class="vd-float absolute top-[58%] -right-3.5 m-0 hidden rounded-[10px] border border-rule-strong bg-surface px-3.5 py-2.5 font-mono text-xs leading-normal shadow-[0_12px_28px_rgba(26,26,46,0.12)] md:block" style="animation-delay: -3s">
      <span class="text-[#157a60]">✓ 3/3 steps passed</span><br />screenshots + video kept
    </p>
  </div>
</section>
