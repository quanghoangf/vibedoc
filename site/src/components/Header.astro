---
import Logo from './Logo.astro'
import GitHubIcon from './GitHubIcon.astro'
import { DOCS, GITHUB } from '../data/links'

// Section links go through the home page, so they also work from /changelog
const home = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`
const nav = [
  { href: `${home}#sdd`, label: 'Spec-driven' },
  { href: `${home}#loop`, label: 'How it works' },
  { href: `${home}#features`, label: 'Features' },
  { href: `${home}#install`, label: 'Install' },
  { href: DOCS, label: 'Docs' },
]
---
<header class="sticky top-0 z-10 border-b border-rule bg-paper/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-[1200px] flex-wrap items-center gap-x-6 gap-y-2 px-5 py-3 sm:px-8">
    <a href={home} class="flex items-center gap-2.5 no-underline">
      <Logo />
      <span class="text-base font-semibold tracking-[-0.01em]">VibeDoc</span>
    </a>
    <nav aria-label="Main" class="ml-auto flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
      {nav.map((n) => <a href={n.href} class="hidden text-pencil no-underline hover:text-ink md:inline">{n.label}</a>)}
      <a href={GITHUB} data-goatcounter-click="github-header" class="inline-flex min-h-10 items-center gap-2 rounded-md bg-ink px-3 text-white no-underline hover:bg-night">
        <GitHubIcon />
        <span>GitHub</span>
        <span data-stars hidden class="font-mono text-xs text-[#c8c8dc]"></span>
      </a>
    </nav>
  </div>
</header>

<script>
  // Live star count; on any failure the button just reads "GitHub"
  import { STARS_API } from '../data/links'
  const slot = document.querySelector<HTMLElement>('[data-stars]')
  fetch(STARS_API, { headers: { accept: 'application/vnd.github+json' } })
    .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
    .then((repo: { stargazers_count?: number }) => {
      const n = repo.stargazers_count
      if (!slot || typeof n !== 'number') return
      slot.textContent = `★ ${n >= 1000 ? `${(n / 1000).toFixed(n >= 10_000 ? 0 : 1)}k` : n}`
      slot.setAttribute('aria-label', `${n.toLocaleString('en')} stars`)
      slot.hidden = false
    })
    .catch(() => {})
</script>
