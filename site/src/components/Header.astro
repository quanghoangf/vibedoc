---
import Logo from './Logo.astro'
import GitHubIcon from './GitHubIcon.astro'
import { DOCS, GITHUB } from '../data/links'

const nav = [
  { href: '#sdd', label: 'Spec-driven' },
  { href: '#loop', label: 'How it works' },
  { href: '#features', label: 'Features' },
  { href: '#install', label: 'Install' },
  { href: DOCS, label: 'Docs' },
]
---
<header class="sticky top-0 z-10 border-b border-rule bg-paper/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-[1200px] flex-wrap items-center gap-x-6 gap-y-2 px-5 py-3 sm:px-8">
    <a href="#top" class="flex items-center gap-2.5 no-underline">
      <Logo />
      <span class="text-base font-semibold tracking-[-0.01em]">VibeDoc</span>
    </a>
    <nav aria-label="Main" class="ml-auto flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
      {nav.map((n) => <a href={n.href} class="hidden text-pencil no-underline hover:text-ink md:inline">{n.label}</a>)}
      <a href={GITHUB} class="inline-flex min-h-10 items-center gap-2 rounded-md bg-ink px-3 text-white no-underline hover:bg-night">
        <GitHubIcon />
        <span>GitHub</span>
      </a>
    </nav>
  </div>
</header>
